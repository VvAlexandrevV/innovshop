{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}
    <h1>Mon panier</h1>

    {% for ligne in lignesPanier %}
        <div class="product-card">
            <h2>{{ ligne.product.nom }}</h2>
            <p><strong>Prix :</strong> {{ ligne.product.prix }} €</p>

            <a href="{{ path('app_panier_remove', {index: ligne.index}) }}" class='remove-product'>Supprimer</a>

            <a href="{{ path('app_product_detail', {id: ligne.product.id}) }}" class='product-link'>Voir le détail</a>
        </div>
    {% else %}
        <p>Votre panier est vide.</p>
    {% endfor %}

    <h2>Total : {{ total }} €</h2>

    <a href="{{ path('app_panier_clear') }}" class='btn-vider-panier'>Vider le panier</a>
{% endblock %}