{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}
    <section class="checkout-page">
        <div class="container">
            <div class="checkout-header">
                <a href="{{ path('app_product') }}" class="checkout-back-link">← Retour au catalogue</a>
                <h1>Mon panier</h1>
                <p>Vérifiez vos articles avant de passer à la commande.</p>
            </div>

            {% if lignesPanier is not empty %}
                <div class="checkout-grid">
                    <div class="checkout-main">
                        <section class="checkout-card">
                            <div class="checkout-section-title">
                                <span class="checkout-step">01</span>
                                <h2>Articles sélectionnés</h2>
                            </div>

                            <div class="checkout-products">
                                {% for ligne in lignesPanier %}
                                    <article class="checkout-product">
                                        <div class="checkout-product-image">
                                            {% if ligne.product.image %}
                                                <img src="{{ asset('images/products/' ~ ligne.product.image) }}" alt="{{ ligne.product.nom }}">
                                            {% else %}
                                                <img src="{{ asset('images/default-product.png') }}" alt="Image par défaut">
                                            {% endif %}
                                        </div>

                                        <div class="checkout-product-content">
                                            <div class="checkout-product-top">
                                                <div>
                                                    <h3>{{ ligne.product.nom }}</h3>
                                                    <p class="checkout-product-description">
                                                        {{ ligne.product.description|length > 120 ? ligne.product.description|slice(0, 120) ~ '...' : ligne.product.description }}
                                                    </p>
                                                   {% if ligne.variants is not empty %}
                                                        <div class="checkout-product-variant">
                                                            <span>Options sélectionnées :</span>

                                                            {% for variant in ligne.variants %}
                                                                <p>
                                                                    {{ variant.type }} : {{ variant.value }}

                                                                    {% if variant.priceModifier %}
                                                                        <span>(+{{ variant.priceModifier }} €)</span>
                                                                    {% endif %}
                                                                </p>
                                                            {% endfor %}
                                                        </div>
                                                    {% endif %}
                                                </div>

                                                <div class="checkout-product-price">
                                                    {{ ligne.price }} €
                                                </div>
                                            </div>

                                            <div class="checkout-product-bottom">
                                                <span class="checkout-qty">Quantité : 1</span>

                                                <div class="checkout-product-actions">
                                                    <a href="{{ path('app_product_detail', {id: ligne.product.id}) }}" class="small-link">
                                                        Voir le détail
                                                    </a>

                                                    {% if app.user %}
                                                        <a href="{{ path('app_panier_remove_cart_item', {id: ligne.id}) }}" class="small-link danger-link">
                                                            Supprimer
                                                        </a>
                                                    {% else %}
                                                        <a href="{{ path('app_panier_remove_session', {index: ligne.index}) }}" class="small-link danger-link">
                                                            Supprimer
                                                        </a>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    </article>
                                {% endfor %}
                            </div>
                        </section>
                    </div>

                    <aside class="checkout-sidebar">
                        <div class="checkout-summary-card">
                            <h2>Résumé</h2>

                            <div class="summary-lines">
                                <div class="summary-line">
                                    <span>Total articles</span>
                                    <strong>{{ lignesPanier|length }}</strong>
                                </div>

                                <div class="summary-line">
                                    <span>Sous-total</span>
                                    <strong>{{ total }} €</strong>
                                </div>

                                <div class="summary-line">
                                    <span>Livraison</span>
                                    <strong class="summary-free">Offerte</strong>
                                </div>
                            </div>

                            <div class="summary-total">
                                <span>Total</span>
                                <strong>{{ total }} €</strong>
                            </div>

                            <div class="cart-summary-actions">
                                <a href="{{ path('app_panier_validation_commande') }}" class="btn btn-primary checkout-submit">
                                    Passer à la commande
                                </a>

                                <a href="{{ path('app_panier_clear') }}" class="btn btn-secondary cart-clear-btn">
                                    Vider le panier
                                </a>
                            </div>
                        </div>
                    </aside>
                </div>
            {% else %}
                <div class="checkout-card empty-cart-box">
                    <p class="empty-state">Votre panier est vide.</p>
                    <a href="{{ path('app_product') }}" class="btn btn-primary">
                        Retour au catalogue
                    </a>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}