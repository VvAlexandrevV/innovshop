{% extends 'base.html.twig' %}

{% block title %}Accueil | InnovShop{% endblock %}

{% block body %}
    {#
        HERO ACCUEIL

        Bloc principal de la page d'accueil.
        Il présente InnovShop et donne accès au catalogue.
    #}
    <section class="hero-section">
        <div class="hero-background">
            <img src="{{ asset('images/hero.png') }}" alt="Hero InnovShop">
            <div class="hero-overlay"></div>
        </div>

        <div class="hero-content container">
            <span class="hero-badge">Boutique nouvelle génération</span>

            <h1>
                INNOV<br>
                <span>SHOP</span>
            </h1>

            <p>
                Découvrez une sélection de produits innovants, modernes et soigneusement choisis
                pour améliorer votre quotidien.
            </p>

            <div class="hero-actions">
                <a href="{{ path('app_product') }}" class="btn btn-primary">Voir le catalogue</a>
                <a href="#featured-products" class="btn btn-secondary">Produits à la une</a>
            </div>
        </div>
    </section>

    {#
        PRODUITS À LA UNE

        Boucle sur les produits à la une envoyés par HomeController.
        Les produits vendeurs sans Stripe Connect sont déjà filtrés
        dans ProductRepository.
    #}
    <section id="featured-products" class="product-section">
        <div class="container">
            <div class="section-header">
                <div>
                    <span class="section-tag">Sélection premium</span>
                    <h2>Produits à la une</h2>
                </div>

                <a href="{{ path('app_product') }}" class="section-link">Voir le catalogue</a>
            </div>

            <div class="products-grid">
                {% for product in produitsALaUne %}
                    {#
                        Vérifie si le produit peut être acheté.
                        isAvailable() tient compte :
                        - de l'activation
                        - du blocage admin
                        - du stock produit
                        - du stock des variantes
                    #}
                    {% set isUnavailable = not product.isAvailable %}

                    {#
                        Détermine le nom du vendeur affiché sur la carte.
                        Si le produit n'a pas de seller, il appartient à InnovShop.
                    #}
                    {% set sellerName = product.seller and product.seller.sellerProfile
                        ? product.seller.sellerProfile.companyName
                        : 'InnovShop'
                    %}

                    <div class="product-card {{ isUnavailable ? 'product-card-unavailable' : '' }}">
                        <div class="product-image-wrapper">
                            {% if isUnavailable %}
                                <span class="badge-unavailable">Indisponible</span>
                            {% endif %}

                            {% if product.image %}
                                <img src="{{ asset('images/products/' ~ product.image) }}" alt="{{ product.nom }}" class="product-image">
                            {% else %}
                                <img src="{{ asset('images/default-product.png') }}" alt="Image par défaut" class="product-image">
                            {% endif %}
                        </div>

                        <div class="product-content">
                            <h3>{{ product.nom }}</h3>

                            {#
                                Affiche l'entreprise vendeuse.
                                Pour les produits admin, on affiche InnovShop.
                            #}
                            <p class="product-seller">
                                Vendu par :
                                <strong>{{ sellerName }}</strong>
                            </p>

                            <p class="product-description">
                                {{ product.description|length > 100 ? product.description|slice(0, 100) ~ '...' : product.description }}
                            </p>

                            <div class="product-footer">
                                <span class="product-price">{{ product.prix }} €</span>
                            </div>

                            {#
                                Actions produit :
                                - détail toujours disponible
                                - ajout au panier seulement si le produit est disponible
                                - choix d'option si le produit possède des variantes
                            #}
                            <div class="product-actions">
                                <a href="{{ path('app_product_detail', { id: product.id }) }}" class="btn btn-secondary">
                                    Voir le détail
                                </a>

                                {% if isUnavailable %}
                                    <span class="btn btn-disabled">
                                        Indisponible
                                    </span>
                                {% elseif product.variants|length > 0 %}
                                    <a href="{{ path('app_product_detail', { id: product.id }) }}" class="btn btn-primary">
                                        Choisir une option
                                    </a>
                                {% else %}
                                    <a href="{{ path('app_panier_add', { id: product.id }) }}" class="btn btn-primary">
                                        Ajouter au panier
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="empty-state">Aucun produit à la une pour le moment.</p>
                {% endfor %}
            </div>
        </div>
    </section>

    {#
        DERNIERS PRODUITS AJOUTÉS

        Boucle sur les derniers produits visibles.
        Les produits vendeurs sans Stripe Connect sont déjà exclus
        par ProductRepository.
    #}
    <section class="product-section alt-section">
        <div class="container">
            <div class="section-header">
                <div>
                    <span class="section-tag">Dernières nouveautés</span>
                    <h2>Derniers produits ajoutés</h2>
                </div>
            </div>

            <div class="products-grid">
                {% for product in derniersProduits %}
                    {#
                        Vérifie si le produit peut être acheté.
                        Cela évite de marquer indisponible un produit qui a
                        des variantes encore disponibles.
                    #}
                    {% set isUnavailable = not product.isAvailable %}

                    {#
                        Détermine le nom du vendeur affiché sur la carte.
                        Si seller est null, le produit appartient à InnovShop.
                    #}
                    {% set sellerName = product.seller and product.seller.sellerProfile
                        ? product.seller.sellerProfile.companyName
                        : 'InnovShop'
                    %}

                    <div class="product-card {{ isUnavailable ? 'product-card-unavailable' : '' }}">
                        <div class="product-image-wrapper">
                            {% if isUnavailable %}
                                <span class="badge-unavailable">Indisponible</span>
                            {% endif %}

                            {% if product.image %}
                                <img src="{{ asset('images/products/' ~ product.image) }}" alt="{{ product.nom }}" class="product-image">
                            {% else %}
                                <img src="{{ asset('images/default-product.png') }}" alt="Image par défaut" class="product-image">
                            {% endif %}
                        </div>

                        <div class="product-content">
                            <h3>{{ product.nom }}</h3>

                            {#
                                Affiche l'entreprise vendeuse ou InnovShop
                                si le produit appartient directement à la plateforme.
                            #}
                            <p class="product-seller">
                                Vendu par :
                                <strong>{{ sellerName }}</strong>
                            </p>

                            <p class="product-description">
                                {{ product.description|length > 100 ? product.description|slice(0, 100) ~ '...' : product.description }}
                            </p>

                            <div class="product-footer">
                                <span class="product-price">{{ product.prix }} €</span>
                            </div>

                            {#
                                Actions produit :
                                - bouton détail
                                - bouton panier ou choix d'option
                                - bouton indisponible si aucun stock utilisable
                            #}
                            <div class="product-actions">
                                <a href="{{ path('app_product_detail', { id: product.id }) }}" class="btn btn-secondary">
                                    Voir le détail
                                </a>

                                {% if isUnavailable %}
                                    <span class="btn btn-disabled">
                                        Indisponible
                                    </span>
                                {% elseif product.variants|length > 0 %}
                                    <a href="{{ path('app_product_detail', { id: product.id }) }}" class="btn btn-primary">
                                        Choisir une option
                                    </a>
                                {% else %}
                                    <a href="{{ path('app_panier_add', { id: product.id }) }}" class="btn btn-primary">
                                        Ajouter au panier
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="empty-state">Aucun produit récent disponible.</p>
                {% endfor %}
            </div>
        </div>
    </section>

    {#
        NEWSLETTER

        Formulaire visuel pour la future newsletter.
        Il n'est pas encore relié à une logique backend.
    #}
    <section class="newsletter-section">
        <div class="container newsletter-box">
            <h2>Restez connecté à InnovShop</h2>

            <p>
                Recevez nos nouveautés, nos sélections et les prochains produits mis en avant.
            </p>

            <form class="newsletter-form">
                <input type="email" placeholder="Votre adresse email">
                <button type="submit" class="btn btn-primary">S'inscrire</button>
            </form>
        </div>
    </section>
{% endblock %}