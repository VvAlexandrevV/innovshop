{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
    {# Page principale de modification du profil utilisateur #}
    <section class="profile-edit-page">
        <div class="container">

            {# En-tête de la page : titre + petite description #}
            <div class="profile-edit-header">
                <span class="profile-edit-badge">Espace client</span>
                <h1>Modifier mon profil</h1>
                <p>
                    Mettez à jour vos informations personnelles, votre adresse de livraison
                    et votre mot de passe.
                </p>
            </div>

            {# Message affiché après une modification réussie #}
            {% for message in app.flashes('success') %}
                <div class="flash-message flash-success">
                    <span class="flash-icon">✓</span>
                    {{ message }}
                </div>
            {% endfor %}

            {# Carte contenant le formulaire de modification du profil #}
            <div class="profile-edit-card">
                {{ form_start(profileForm, {'attr': {'class': 'profile-edit-form'}}) }}

                    {# Champ : prénom #}
                    <div class="form-group">
                        {{ form_label(profileForm.firstname) }}
                        {{ form_widget(profileForm.firstname) }}
                        {{ form_errors(profileForm.firstname) }}
                    </div>

                    {# Champ : nom #}
                    <div class="form-group">
                        {{ form_label(profileForm.lastname) }}
                        {{ form_widget(profileForm.lastname) }}
                        {{ form_errors(profileForm.lastname) }}
                    </div>

                    {# Champ : téléphone #}
                    <div class="form-group">
                        {{ form_label(profileForm.phone) }}
                        {{ form_widget(profileForm.phone) }}
                        {{ form_errors(profileForm.phone) }}
                    </div>

                    {# Champ : email #}
                    <div class="form-group">
                        {{ form_label(profileForm.email) }}
                        {{ form_widget(profileForm.email) }}
                        {{ form_errors(profileForm.email) }}
                    </div>

                    {# Champ : adresse complète, sur toute la largeur #}
                    <div class="form-group full-width">
                        {{ form_label(profileForm.address) }}
                        {{ form_widget(profileForm.address) }}
                        {{ form_errors(profileForm.address) }}
                    </div>

                    {# Champ : code postal #}
                    <div class="form-group">
                        {{ form_label(profileForm.postalCode) }}
                        {{ form_widget(profileForm.postalCode) }}
                        {{ form_errors(profileForm.postalCode) }}
                    </div>

                    {# Champ : ville #}
                    <div class="form-group">
                        {{ form_label(profileForm.city) }}
                        {{ form_widget(profileForm.city) }}
                        {{ form_errors(profileForm.city) }}
                    </div>

                    {# Champ : pays, sur toute la largeur #}
                    <div class="form-group full-width">
                        {{ form_label(profileForm.country) }}
                        {{ form_widget(profileForm.country) }}
                        {{ form_errors(profileForm.country) }}
                    </div>

                    {# Zone optionnelle de changement du mot de passe #}
                    <div class="profile-password-section">
                        <h2>Changer mon mot de passe</h2>
                        <p>
                            Laissez ces champs vides si vous ne souhaitez pas modifier votre mot de passe.
                        </p>

                        <div class="profile-password-grid">
                            {# Nouveau mot de passe #}
                            <div class="form-group">
                                {{ form_label(profileForm.plainPassword.first) }}
                                {{ form_widget(profileForm.plainPassword.first) }}
                                {{ form_errors(profileForm.plainPassword.first) }}
                            </div>

                            {# Confirmation du nouveau mot de passe #}
                            <div class="form-group">
                                {{ form_label(profileForm.plainPassword.second) }}
                                {{ form_widget(profileForm.plainPassword.second) }}
                                {{ form_errors(profileForm.plainPassword.second) }}
                            </div>
                        </div>

                        {# Erreur globale si les deux mots de passe ne correspondent pas #}
                        {{ form_errors(profileForm.plainPassword) }}
                    </div>

                    {# Boutons d’action du formulaire #}
                    <div class="profile-edit-actions">
                        <button type="submit" class="btn btn-primary">
                            Enregistrer
                        </button>

                        <a href="{{ path('app_account') }}" class="btn btn-secondary">
                            Retour à mon compte
                        </a>
                    </div>

                {{ form_end(profileForm) }}
            </div>
        </div>
    </section>
{% endblock %}