{% extends 'base.html.twig' %}

{% block title %}{{ product.nom }} | InnovShop{% endblock %}

{% block body %}
    {% set baseStockAvailable = product.stock > 0 %}
    {% set hasAvailableVariant = product.hasAvailableVariant %}
    {% set productAvailable = product.isAvailable %}

    <section class="product-detail-hero">
        <div class="container product-detail-grid">
            <div class="product-detail-media">
                <div class="product-detail-main-image">
                    {% if product.image %}
                        <img src="{{ asset('images/products/' ~ product.image) }}" alt="{{ product.nom }}">
                    {% else %}
                        <img src="{{ asset('images/default-product.png') }}" alt="Image par défaut">
                    {% endif %}
                </div>
            </div>

            <div class="product-detail-info">
                <span class="detail-tag">Produit InnovShop</span>

                <h1>{{ product.nom }}</h1>

                <p class="detail-intro">{{ product.description }}</p>

                <div class="detail-highlight-boxes">
                    <div class="detail-highlight">
                        <span class="detail-highlight-label">Prix</span>
                        <strong id="product-dynamic-price" data-base-price="{{ product.prix }}">
                            {{ product.prix }} €
                        </strong>
                    </div>

                    <div class="detail-highlight">
                        <span class="detail-highlight-label">Disponibilité</span>

                        {% if productAvailable %}
                            {% if baseStockAvailable %}
                                <strong>{{ product.stock }} disponible{{ product.stock > 1 ? 's' : '' }}</strong>
                            {% else %}
                                <strong>Disponible avec option</strong>
                            {% endif %}
                        {% else %}
                            <strong class="stock-unavailable">Non disponible</strong>
                        {% endif %}
                    </div>
                </div>

                <form
                    method="post"
                    action="{{ path('app_panier_add', {id: product.id}) }}"
                    data-turbo="false"
                    id="product-add-form"
                    data-base-stock="{{ product.stock }}"
                >
                    {% if product.variants|length > 0 %}
                        <div class="product-variants-box">
                            <h2>Options disponibles</h2>

                            <div class="product-variants-list">
                                {% for variant in product.variants %}
                                    {% set variantAvailable = variant.stock > 0 %}

                                    <label class="product-variant-card selectable-variant {{ not variantAvailable ? 'variant-disabled' : '' }}">
                                        <input
                                            type="checkbox"
                                            name="variantIds[]"
                                            value="{{ variant.id }}"
                                            data-price-modifier="{{ variant.priceModifier ?: 0 }}"
                                            data-stock="{{ variant.stock }}"
                                            {{ not variantAvailable ? 'disabled' : '' }}
                                        >

                                        <span class="variant-content">
                                            <strong>{{ variant.type }} :</strong>
                                            <span class="variant-pill">{{ variant.value }}</span>

                                            {% if variant.priceModifier %}
                                                <small class="variant-price-modifier">
                                                    +{{ variant.priceModifier }} €
                                                </small>
                                            {% endif %}

                                            {% if variantAvailable %}
                                                <small class="variant-stock">
                                                    {{ variant.stock }} disponible{{ variant.stock > 1 ? 's' : '' }}
                                                </small>
                                            {% else %}
                                                <small class="variant-stock variant-stock-unavailable">
                                                    Non disponible
                                                </small>
                                            {% endif %}
                                        </span>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <div class="detail-actions">
                        <button
                            type="submit"
                            class="btn btn-primary"
                            id="add-to-cart-button"
                            {{ not productAvailable ? 'disabled' : '' }}
                        >
                            Ajouter au panier
                        </button>

                        <a href="{{ path('app_product') }}" class="btn btn-secondary">
                            Retour au catalogue
                        </a>
                    </div>

                    {% if not productAvailable %}
                        <p class="product-unavailable-message">
                            Ce produit n’est plus disponible.
                        </p>
                    {% elseif not baseStockAvailable and hasAvailableVariant %}
                        <p class="product-option-required-message">
                            Le produit de base n’est plus disponible. Sélectionnez une option disponible.
                        </p>
                    {% endif %}
                </form>
            </div>
        </div>
    </section>

    <section class="product-detail-section">
        <div class="container detail-content-grid">
            <div class="detail-description-card">
                <span class="section-tag">Description</span>
                <h2>À propos du produit</h2>
                <p>{{ product.description }}</p>
            </div>

            <div class="detail-specs-card">
                <span class="section-tag">Fiche technique</span>
                <h2>Caractéristiques</h2>

                <div class="detail-specs-list">
                    <div class="detail-spec-row">
                        <span>Nom</span>
                        <strong>{{ product.nom }}</strong>
                    </div>

                    <div class="detail-spec-row">
                        <span>Prix</span>
                        <strong>{{ product.prix }} €</strong>
                    </div>

                    <div class="detail-spec-row">
                        <span>Stock produit de base</span>
                        <strong>{{ product.stock }}</strong>
                    </div>

                    {% if product.category is defined and product.category %}
                        <div class="detail-spec-row">
                            <span>Catégorie</span>
                            <strong>{{ product.category.nom }}</strong>
                        </div>
                    {% endif %}

                    {% if product.specification is defined and product.specification %}
                        <div class="detail-spec-row">
                            <span>Spécifications</span>
                            <strong>{{ product.specification }}</strong>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

    <section class="product-detail-section alt-section">
        <div class="container detail-extra-box">
            <span class="section-tag">Pourquoi ce produit ?</span>
            <h2>Un choix pensé pour l’expérience utilisateur</h2>
            <p>
                Ce produit s’intègre dans l’univers InnovShop avec une approche moderne, claire et orientée qualité.
                L’objectif n’est pas juste d’afficher un article, mais de lui donner une vraie présence visuelle
                et une lecture plus premium.
            </p>
        </div>
    </section>

    <script>
        const form = document.querySelector('#product-add-form');
        const priceElement = document.querySelector('#product-dynamic-price');
        const variantInputs = document.querySelectorAll('input[name="variantIds[]"]');
        const addToCartButton = document.querySelector('#add-to-cart-button');

        if (form && priceElement && addToCartButton) {
            const basePrice = parseFloat(priceElement.dataset.basePrice);
            const baseStock = parseInt(form.dataset.baseStock, 10);

            function updateProductState() {
                let finalPrice = basePrice;
                let hasSelectedAvailableVariant = false;

                variantInputs.forEach((variantInput) => {
                    if (variantInput.checked) {
                        finalPrice += parseFloat(variantInput.dataset.priceModifier || 0);

                        if (parseInt(variantInput.dataset.stock, 10) > 0) {
                            hasSelectedAvailableVariant = true;
                        }
                    }
                });

                priceElement.textContent = finalPrice.toFixed(2).replace('.', ',') + ' €';

                if (baseStock > 0) {
                    addToCartButton.disabled = false;
                    return;
                }

                addToCartButton.disabled = !hasSelectedAvailableVariant;
            }

            variantInputs.forEach((input) => {
                input.addEventListener('change', updateProductState);
            });

            updateProductState();
        }
    </script>
{% endblock %}