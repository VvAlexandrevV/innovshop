{% extends 'base.html.twig' %}

{% block title %}Catalogue produits{% endblock %}

{% block body %}

    <section class="catalogue">
        <h1>Catalogue produits</h1>
        <div class="count">
    {{ products.getTotalItemCount }} produits
</div>
        <div class="products-grid">
            {% for product in products %}
                <div class="product-card">
                    {% if product.image %}
                <img src="{{ asset('images/products/' ~ product.image) }}" alt="{{ product.nom }}" class="product-image">
            {% else %}
                <img src="{{ asset('images/default-product.png') }}" alt="Image par défaut" class="product-image">
            {% endif %}
                    <h2>{{ product.nom }}</h2>
                    <p><strong>Prix :</strong> {{ product.prix }} €</p>
                    <p><strong>Description du produit :</strong><br>{{ product.description }}</p>

                    {% if product.aLaUne %}
                        <span class="badge-featured">À la une</span>
                    {% endif %}

                    <a href="{{ path('app_product_detail', {id: product.id}) }}" class="product-link">Voir le détail</a>
                    <a href="{{ path('app_panier_add', {id: product.id}) }}" class="ajout_panier">Ajouter au panier</a>
                </div>
            {% else %}
                <p>Aucun produit trouvé</p>
            {% endfor %}
        </div>
        <div class="navigation">
    {{ knp_pagination_render(products) }}
</div>
    </section>

{% endblock %}