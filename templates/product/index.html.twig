{% extends 'base.html.twig' %}

{% block title %}Catalogue produits{% endblock %}

{% block body %}
    <section class="catalogue-section">
        <div class="container">
            <div class="section-header">
                <div>
                    <span class="section-tag">Catalogue InnovShop</span>
                    <h1>Nos produits</h1>
                </div>

                <div class="count">
                    {{ products.getTotalItemCount }} produits
                </div>
            </div>

            <section class="catalog-filters">
                <form method="get" action="{{ path('app_product') }}" class="catalog-search-form" id="catalog-search-form">
                    <input 
                        type="text" 
                        name="q" 
                        id="catalog-search-input"
                        value="{{ search }}" 
                        placeholder="Rechercher un produit..." 
                        class="catalog-search-input"
                    >

                    <input 
                        type="number" 
                        name="minPrice" 
                        id="catalog-min-price"
                        value="{{ minPrice }}" 
                        placeholder="Prix min" 
                        class="catalog-search-input"
                    >

                    <input 
                        type="number" 
                        name="maxPrice" 
                        id="catalog-max-price"
                        value="{{ maxPrice }}" 
                        placeholder="Prix max" 
                        class="catalog-search-input"
                    >

                    {% if selectedCategory %}
                        <input type="hidden" name="category" value="{{ selectedCategory }}">
                    {% endif %}

                    <select name="tri" class="catalog-tri-select" id="catalog-tri-select">
                        <option value="newest" {{ tri == 'newest' ? 'selected' : '' }}>
                            Plus récents
                        </option>
                        <option value="price_asc" {{ tri == 'price_asc' ? 'selected' : '' }}>
                            Prix croissant
                        </option>
                        <option value="price_desc" {{ tri == 'price_desc' ? 'selected' : '' }}>
                            Prix décroissant
                        </option>
                    </select>

                    <button type="submit" class="btn btn-primary">
                        Rechercher
                    </button>
                </form>

                <div class="category-tabs">
                    <a 
                        href="{{ path('app_product', {q: search, tri: tri, minPrice: minPrice, maxPrice: maxPrice}) }}" 
                        data-category-id="0"
                        class="category-tab {{ selectedCategory == 0 ? 'active' : '' }}"
                    >
                        Tous
                    </a>

                    {% for category in categories %}
                        <a 
                            href="{{ path('app_product', {category: category.id, q: search, tri: tri, minPrice: minPrice, maxPrice: maxPrice}) }}" 
                            data-category-id="{{ category.id }}"
                            class="category-tab {{ selectedCategory == category.id ? 'active' : '' }}"
                        >
                            {{ category.nom }}
                        </a>
                    {% endfor %}
                </div>
            </section>

            <div 
                id="catalog-results"
                data-search-url="{{ path('app_product_search') }}"
            >
                {% include 'product/_products_grid.html.twig' with { products: products } %}
            </div>
        </div>
    </section>
{% endblock %}