{% extends 'base.html.twig' %}

{% block title %}Catalogue produits{% endblock %}

{% block body %}
    <section class="catalogue-section">
        <div class="container">
            <div class="section-header">
                <div>
                    <span class="section-tag">Catalogue InnovShop</span>
                    <h1>Nos produits</h1>
                </div>

                <div class="count">
                    {{ products.getTotalItemCount }} produits
                </div>
            </div>

            <section class="catalog-filters">
                <form method="get" action="{{ path('app_product') }}" class="catalog-search-form">
                    <input 
                        type="text" 
                        name="q" 
                        value="{{ search }}" 
                        placeholder="Rechercher un produit..." 
                        class="catalog-search-input"
                    >

                    {% if selectedCategory %}
                        <input type="hidden" name="category" value="{{ selectedCategory }}">
                    {% endif %}

                    <button type="submit" class="btn btn-primary">
                        Rechercher
                    </button>
                </form>

                <div class="category-tabs">
                    <a 
                        href="{{ path('app_product', {q: search}) }}" 
                        class="category-tab {{ selectedCategory == 0 ? 'active' : '' }}"
                    >
                        Tous
                    </a>

                    {% for category in categories %}
                        <a 
                            href="{{ path('app_product', {category: category.id, q: search}) }}" 
                            class="category-tab {{ selectedCategory == category.id ? 'active' : '' }}"
                        >
                            {{ category.nom }}
                        </a>
                    {% endfor %}
                </div>
            </section>

            <div class="products-grid">
                {% for product in products %}
                    <div class="product-card">
                        <div class="product-image-wrapper">
                            {% if product.image %}
                                <img src="{{ asset('images/products/' ~ product.image) }}" alt="{{ product.nom }}" class="product-image">
                            {% else %}
                                <img src="{{ asset('images/default-product.png') }}" alt="Image par défaut" class="product-image">
                            {% endif %}

                            {% if product.aLaUne %}
                                <span class="badge-featured">À la une</span>
                            {% endif %}
                        </div>

                        <div class="product-content">
                            <h3>{{ product.nom }}</h3>

                            <p class="product-description">
                                {{ product.description|length > 110 ? product.description|slice(0, 110) ~ '...' : product.description }}
                            </p>

                            <div class="product-footer">
                                <span class="product-price">{{ product.prix }} €</span>
                            </div>

                            <div class="product-actions">
                                <a href="{{ path('app_product_detail', {id: product.id}) }}" class="btn btn-secondary">
                                    Voir le détail
                                </a>

                                <a href="{{ path('app_panier_add', {id: product.id}) }}" class="btn btn-primary">
                                    Ajouter au panier
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="empty-state">Aucun produit trouvé.</p>
                {% endfor %}
            </div>

            <div class="navigation">
                {{ knp_pagination_render(products) }}
            </div>
        </div>
    </section>
{% endblock %}