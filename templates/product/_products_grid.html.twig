{% if products.getTotalItemCount > 0 %}
    <div class="navigation navigation-top">
        {{ knp_pagination_render(products) }}
    </div>
{% endif %}

<div class="products-grid">
    {% for product in products %}
        {% set productAvailable = product.available %}

        <div class="product-card {{ not productAvailable ? 'product-card-unavailable' : '' }}">
            <div class="product-image-wrapper">
                {% if product.image %}
                    <img src="{{ asset('images/products/' ~ product.image) }}" alt="{{ product.nom }}" class="product-image">
                {% else %}
                    <img src="{{ asset('images/default-product.png') }}" alt="Image par défaut" class="product-image">
                {% endif %}

                {% if product.aLaUne %}
                    <span class="badge-featured">À la une</span>
                {% endif %}

                {% if not productAvailable %}
                    <span class="badge-unavailable">Indisponible</span>
                {% endif %}
            </div>

            <div class="product-content">
                <h3>{{ product.nom }}</h3>

                <p class="product-seller">
                    Vendu par :
                    <strong>
                        {% if product.seller %}
                            {{ product.seller.sellerProfile ? product.seller.sellerProfile.companyName : product.seller.email }}
                        {% else %}
                            InnovShop
                        {% endif %}
                    </strong>
                </p>

                <p class="product-description">
                    {{ product.description|length > 110 ? product.description|slice(0, 110) ~ '...' : product.description }}
                </p>

                <div class="product-footer">
                    <span class="product-price">{{ product.prix }} €</span>
                </div>

                <div class="product-actions">
                    <a href="{{ path('app_product_detail', {id: product.id}) }}" class="btn btn-secondary">
                        Voir le détail
                    </a>

                    {% if productAvailable %}
                        {% if product.variants|length > 0 %}
                            <a href="{{ path('app_product_detail', {id: product.id}) }}" class="btn btn-primary">
                                Ajouter au panier
                            </a>
                        {% else %}
                            <a href="{{ path('app_panier_add', {id: product.id}) }}" class="btn btn-primary">
                                Ajouter au panier
                            </a>
                        {% endif %}
                    {% else %}
                        <span class="btn btn-secondary btn-disabled">
                            Indisponible
                        </span>
                    {% endif %}
                </div>
            </div>
        </div>
    {% else %}
        <p class="empty-state">Aucun produit trouvé.</p>
    {% endfor %}
</div>

<div class="navigation">
    {{ knp_pagination_render(products) }}
</div>