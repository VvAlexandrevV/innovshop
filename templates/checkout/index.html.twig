{% extends 'base.html.twig' %}

{% block title %}Validation de commande{% endblock %}

{% block body %}
    <h1>Validation de commande</h1>

    <h2>Récapitulatif du panier</h2>

    {% for cartItem in cartItems %}
        <div class="product-card">
            <h3>{{ cartItem.product.nom }}</h3>
            <p><strong>Prix :</strong> {{ cartItem.product.prix }} €</p>
        </div>
    {% endfor %}

        <div class="cart-total">
            <h2>Total de la commande</h2>
            <p><strong>{{ total }} €</strong></p>
            <p>{{ cartItems|length }} article(s)</p>
        </div>

    <h2>Informations de livraison</h2>

    {{ form_start(orderForm) }}
        {{ form_row(orderForm.deliveryFirstName) }}
        {{ form_row(orderForm.deliveryLastName) }}
        {{ form_row(orderForm.deliveryAddress) }}
        {{ form_row(orderForm.deliveryPostalCode) }}
        {{ form_row(orderForm.deliveryCity) }}
        {{ form_row(orderForm.deliveryCountry) }}

        <button type="submit">Confirmer la commande</button>
    {{ form_end(orderForm) }}
{% endblock %}