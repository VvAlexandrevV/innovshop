{% extends 'base.html.twig' %}

{% block title %}Commande confirmée{% endblock %}

{% block body %}
    <h1>Commande confirmée</h1>

    <p><strong>Commande n° :</strong> {{ order.id }}</p>
    <p><strong>Date :</strong> {{ order.createdAt|date('d/m/Y H:i') }}</p>
    <p><strong>Statut :</strong> {{ order.status }}</p>
    <p><strong>Total :</strong> {{ order.total }} €</p>

    <h2>Adresse de livraison</h2>
    <p>{{ order.deliveryFirstName }} {{ order.deliveryLastName }}</p>
    <p>{{ order.deliveryAddress }}</p>
    <p>{{ order.deliveryPostalCode }} {{ order.deliveryCity }}</p>
    <p>{{ order.deliveryCountry }}</p>

    <h2>Lignes de commande</h2>

    {% for orderItem in order.orderItems %}
        <div class="product-card">
            <h3>{{ orderItem.productName }}</h3>
            <p><strong>Prix :</strong> {{ orderItem.productPrice }} €</p>
        </div>
    {% endfor %}
{% endblock %}